# Токен бота — получить у @BotFather (команда /newbot)
BOT_TOKEN=

# Ваш числовой Telegram ID — узнать у @userinfobot.
# Можно оставить пустым: тогда уведомления админа печатаются в консоль.
ADMIN_CHAT_ID=

# Прокси для доступа к Telegram API. Оставьте пустым, если бот работает без него.
# Формат: PROXY_URL=http://123.45.67.89:8080
PROXY_URL=
