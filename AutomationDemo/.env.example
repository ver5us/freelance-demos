# Токен бота — получить у @BotFather (команда /newbot)
BOT_TOKEN=

# Ваш числовой Telegram ID — узнать у @userinfobot.
# Можно оставить пустым: тогда уведомление печатается в консоль.
ADMIN_CHAT_ID=

# Прокси для доступа к Telegram API, если провайдер его блокирует.
# Формат: PROXY_URL=http://123.45.67.89:8080
PROXY_URL=
